# DevOpsLab resource budget (MacBook Air M4, 16 GB).
# Everything Kubernetes runs inside the Colima VM, so the VM size IS the lab budget.
#   Cluster system pods + kind nodes  ~4.0 GB
#   CloudMart (Stage 4)               ~1.5 GB
#   Headroom inside the VM            ~0.5 GB
# Monitoring adds ~1.5 GB: bump COLIMA_MEMORY to 8 before `make monitoring-on`.
COLIMA_PROFILE=devopslab
COLIMA_CPUS=4
COLIMA_MEMORY=6
COLIMA_DISK=40
CLUSTER_NAME=cloudmart
KIND_NODE_IMAGE=kindest/node:v1.31.4

# Docker terminal (Phase 2b): a separate, smaller VM started only while a Docker
# terminal is open and stopped after 10 idle minutes. Nothing from your Mac is
# mounted into it, and a firewall keeps its containers away from your Mac's
# local services. +2 GB RAM while it runs.
DOCKER_VM_PROFILE=devopslab-docker
DOCKER_VM_CPUS=2
DOCKER_VM_MEMORY=2
DOCKER_VM_DISK=20
