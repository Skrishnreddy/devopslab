# Copy to backend/.env to override defaults. Never commit the real .env.
# All variables are optional.

# Where the SQLite database and login token live (default: ~/.devopslab)
# DEVOPSLAB_DATA_DIR=~/.devopslab

# Use PostgreSQL instead of SQLite (future multi-user deployments)
# DEVOPSLAB_DATABASE_URL=postgresql+psycopg://devopslab:change-me@127.0.0.1:5432/devopslab

# Must match infra/config.env
# DEVOPSLAB_COLIMA_PROFILE=devopslab
# DEVOPSLAB_CLUSTER_NAME=cloudmart
# DEVOPSLAB_KUBECONFIG=~/.kube/devopslab

# Browser origins allowed to call the API (JSON list)
# DEVOPSLAB_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Session lifetime in hours
# DEVOPSLAB_SESSION_HOURS=12
